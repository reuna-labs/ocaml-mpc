# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Unix sockets for ocaml-mpc"
description: """
A Mirage_flow.S over Lwt_unix sockets, plus address parsing and an accept
loop, so a FROST participant can be run as an ordinary Unix process.

This is the only package in the repository permitted to depend on unix. Keeping
it separate is what lets the protocol core and the transport cross-compile to a
Solo5 unikernel unchanged."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
tags: ["mpc" "threshold-signatures" "frost" "org:mirage"]
homepage: "https://github.com/reuna-labs/ocaml-mpc"
doc: "https://reuna-labs.github.io/ocaml-mpc/"
bug-reports: "https://github.com/reuna-labs/ocaml-mpc/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.6" & >= "3.6"}
  "mpc-lwt" {= version}
  "lwt" {>= "5.6.0"}
  "cstruct" {>= "6.0.0"}
  "mirage-flow" {>= "4.0.0"}
  "mirage-flow-unix" {>= "4.0.0"}
  "logs"
  "alcotest" {with-test}
  "alcotest-lwt" {with-test}
  "ohex" {with-test & >= "0.2.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-mpc.git"
